# ---------- Supabase (Project Settings > API) ----------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxx

# ---------- Service Role (Project Settings > API > service_role) ----------
# Required for both password-reset features:
#   - /admin/users "ออกโค้ดรีเซ็ต" (admin issues a 6-digit code)
#   - /login "ลืมรหัสผ่าน?" (user submits email + code + new password)
# Server side only. Never commit, never expose to browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxx

# ---------- Optional ----------
# Secret mixed into the reset-code hash before it is stored, so a stolen
# database cannot be used to brute-force precomputed hashes. Any random string.
# RESET_CODE_PEPPER=change-me-to-a-long-random-string

# Set to "false" to disable public signup. Default is open so an evaluator
# can register a test account. Only the first account becomes admin.
# ALLOW_PUBLIC_SIGNUP=false

# Set to "false" to stop writing rows to the audit_log table.
# AUDIT_LOG_ENABLED=true

# Timezone used to count days and render every date in the app.
# Serverless runtimes are UTC, so without this an alarm created after 17:00
# Thai time would be counted on the previous day. Default: Asia/Bangkok
# NEXT_PUBLIC_APP_TIMEZONE=Asia/Bangkok
